{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "director-stage",
  "title": "Director Stage",
  "description": "An interactive Three.js stage for composing characters, props, cameras, and shots.",
  "dependencies": [
    "@react-three/fiber",
    "@react-three/drei",
    "lucide-react",
    "three"
  ],
  "files": [
    {
      "path": "src/components/director-stage/index.ts",
      "content": "export { default as DirectorStage } from \"./DirectorStage\";\nexport type {\n  DirectorBodyType,\n  DirectorCamera,\n  DirectorCharacter,\n  DirectorComposition,\n  DirectorEnvironment,\n  DirectorProp,\n  DirectorPropType,\n  DirectorSelection,\n  DirectorStageProps,\n  DirectorTransformMode,\n  DirectorViewMode,\n  JointAngles,\n  ParsedSceneSeed,\n} from \"./DirectorStage.types\";\n",
      "type": "registry:component",
      "target": "components/director-stage/index.ts"
    },
    {
      "path": "src/components/director-stage/DirectorStage.tsx",
      "content": "import React, { useEffect, useMemo, useRef, useState } from \"react\";\nimport { Box, Camera, Download, Search, Upload, UserPlus } from \"lucide-react\";\nimport DirectorStageCanvas from \"./DirectorStageCanvas\";\nimport { DEFAULT_CHARACTER_MODEL_URL, DEFAULT_COMPOSITION, PROP_OPTIONS, RELAXED_STAND_JOINTS } from \"./DirectorStage.constants\";\nimport { EnvironmentInspector, SelectionInspector } from \"./DirectorStage.inspectors\";\nimport type { SceneItem, ToolMenu } from \"./DirectorStage.sceneTypes\";\nimport { BottomTools, ViewportToolbar } from \"./DirectorStage.toolbars\";\nimport { downloadText, ratioToNumber, type AspectRatio } from \"./DirectorStage.utils\";\nimport SceneTree from \"./SceneTree\";\nimport { useDirectorStage } from \"./hooks/useDirectorStage\";\nimport type {\n  DirectorCamera,\n  DirectorCharacter,\n  DirectorPropType,\n  DirectorStageProps,\n  DirectorTransformMode,\n  ParsedSceneSeed,\n} from \"./DirectorStage.types\";\nimport \"./DirectorStage.css\";\n\nconst SAMPLE_SEED: ParsedSceneSeed = {\n  characters: [\n    {\n      label: \"CharacterA\",\n      bodyType: \"custom\",\n      modelUrl: DEFAULT_CHARACTER_MODEL_URL,\n      animationMode: \"static\",\n      color: \"#4f8ef7\",\n      position: { x: -1, y: 0, z: -0.25 },\n      rotation: { x: 0, y: 18, z: 0 },\n      jointAngles: RELAXED_STAND_JOINTS,\n    },\n  ],\n  props: [\n    { label: \"圆桌1\", propType: \"roundTable\", position: { x: -0.15, y: 0, z: -0.15 } },\n    { label: \"轿车2\", propType: \"car\", position: { x: 0.6, y: 0, z: -1.25 }, rotation: { x: 0, y: -12, z: 0 } },\n  ],\n  cameras: [\n    {\n      label: \"Camera1\",\n      position: { x: 2.068, y: 2.865, z: 5.781 },\n      lookAt: { x: 0, y: 1.2, z: 0 },\n      fov: 50,\n    },\n  ],\n  environment: {\n    showGround: true,\n    groundOpacity: 0.3,\n    skyColor: \"#f8f8f7\",\n  },\n};\n\nexport default function DirectorStage({\n  className,\n  style,\n  initialComposition,\n  storageKey = \"media-rig-director-stage-minimax-light-v6\",\n  onCompositionChange,\n  onCapture,\n}: DirectorStageProps) {\n  const rootRef = useRef<HTMLDivElement>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n  const { state, dispatch } = useDirectorStage(initialComposition, storageKey);\n  const [propType, setPropType] = useState<DirectorPropType>(\"cube\");\n  const [openMenu, setOpenMenu] = useState<ToolMenu>(null);\n  const [aspectRatio, setAspectRatio] = useState<AspectRatio>(\"Auto\");\n  const [isFullscreen, setIsFullscreen] = useState(false);\n  const [jsonDraft, setJsonDraft] = useState(() => JSON.stringify(SAMPLE_SEED, null, 2));\n  const [jsonMessage, setJsonMessage] = useState(\"可粘贴角色、道具、机位 JSON\");\n\n  useEffect(() => {\n    onCompositionChange?.(state.composition);\n  }, [onCompositionChange, state.composition]);\n\n  useEffect(() => {\n    const handleKeyDown = (event: KeyboardEvent) => {\n      const target = event.target as HTMLElement | null;\n      const tag = target?.tagName;\n      if (tag === \"INPUT\" || tag === \"TEXTAREA\" || tag === \"SELECT\") return;\n      if (event.key.toLowerCase() === \"v\") dispatch({ type: \"setTransformMode\", mode: \"translate\" });\n      if (event.key.toLowerCase() === \"r\") dispatch({ type: \"setTransformMode\", mode: \"rotate\" });\n      if (event.key.toLowerCase() === \"s\") dispatch({ type: \"setTransformMode\", mode: \"scale\" });\n      if (event.key === \"Escape\") setOpenMenu(null);\n    };\n    window.addEventListener(\"keydown\", handleKeyDown);\n    return () => window.removeEventListener(\"keydown\", handleKeyDown);\n  }, [dispatch]);\n\n  useEffect(() => {\n    const updateFullscreen = () => setIsFullscreen(Boolean(document.fullscreenElement));\n    document.addEventListener(\"fullscreenchange\", updateFullscreen);\n    return () => document.removeEventListener(\"fullscreenchange\", updateFullscreen);\n  }, []);\n\n  const selectedItem = useMemo<SceneItem | null>(() => {\n    if (!state.selection) return null;\n    if (state.selection.kind === \"character\") {\n      const item = state.composition.characters.find((character) => character.id === state.selection?.id);\n      return item ? { kind: \"character\", item } : null;\n    }\n    if (state.selection.kind === \"prop\") {\n      const item = state.composition.props.find((prop) => prop.id === state.selection?.id);\n      return item ? { kind: \"prop\", item } : null;\n    }\n    const item = state.composition.cameras.find((camera) => camera.id === state.selection?.id);\n    return item ? { kind: \"camera\", item } : null;\n  }, [state.composition, state.selection]);\n\n  const captureCanvas = () => {\n    const canvas = rootRef.current?.querySelector(\"canvas\");\n    if (!canvas) return;\n    const dataUrl = canvas.toDataURL(\"image/png\");\n    onCapture?.(dataUrl);\n    const anchor = document.createElement(\"a\");\n    anchor.download = \"director-stage.png\";\n    anchor.href = dataUrl;\n    anchor.click();\n  };\n\n  const importJson = () => {\n    try {\n      dispatch({ type: \"importSeed\", seed: JSON.parse(jsonDraft) as ParsedSceneSeed });\n      setJsonMessage(\"已导入场景 seed\");\n    } catch {\n      setJsonMessage(\"JSON 格式不正确\");\n    }\n  };\n\n  const addUploadedModel = (file: File | undefined) => {\n    if (!file) return;\n    const url = URL.createObjectURL(file);\n    dispatch({ type: \"addCharacter\", modelUrl: url, label: file.name.replace(/\\.(glb|gltf)$/i, \"\") || \"自定义角色\" });\n    setOpenMenu(null);\n  };\n\n  const setMode = (mode: DirectorTransformMode) => {\n    dispatch({ type: \"setTransformMode\", mode });\n    setOpenMenu(null);\n  };\n\n  const addCharacter = (bodyType: DirectorCharacter[\"bodyType\"], label?: string) => {\n    dispatch({ type: \"addCharacter\", bodyType, label });\n    setOpenMenu(null);\n  };\n\n  const addCrowd = () => {\n    const spacing = 0.72;\n    for (let row = 0; row < 3; row += 1) {\n      for (let col = 0; col < 3; col += 1) {\n        dispatch({\n          type: \"addCharacter\",\n          bodyType: \"mannequin\",\n          label: `群众 ${row * 3 + col + 1}`,\n          position: { x: (col - 1) * spacing, y: 0, z: 0.8 + row * spacing },\n        });\n      }\n    }\n    setOpenMenu(null);\n  };\n\n  const addProp = (nextPropType: DirectorPropType, label?: string) => {\n    dispatch({ type: \"addProp\", propType: nextPropType, label });\n    setPropType(nextPropType);\n    setOpenMenu(null);\n  };\n\n  const addCamera = (camera?: Partial<DirectorCamera>) => {\n    dispatch({ type: \"addCamera\", camera });\n    setOpenMenu(null);\n  };\n\n  const applyCurrentViewCamera = () => {\n    if (selectedItem?.kind === \"camera\") {\n      addCamera({\n        label: `${selectedItem.item.label} Copy`,\n        position: selectedItem.item.position,\n        lookAt: selectedItem.item.lookAt,\n        fov: selectedItem.item.fov,\n      });\n      return;\n    }\n    addCamera();\n  };\n\n  const toggleFullscreen = async () => {\n    try {\n      if (document.fullscreenElement) {\n        await document.exitFullscreen();\n      } else {\n        await rootRef.current?.requestFullscreen();\n      }\n    } catch {\n      // Browsers may reject fullscreen without a trusted user gesture.\n    }\n    setOpenMenu(null);\n  };\n\n  const aspectNumber = ratioToNumber(aspectRatio);\n  const stageClassName = [\"director-stage\", isFullscreen ? \"is-fullscreen\" : \"\", className].filter(Boolean).join(\" \");\n\n  return (\n    <div className={stageClassName} style={style} ref={rootRef}>\n      <header className=\"director-stage__topbar\">\n        <div className=\"director-stage__brand\">\n          <span className=\"director-stage__brand-mark\">♟</span>\n          <h1>3D 导演台</h1>\n        </div>\n        <div className=\"director-stage__top-actions\">\n          <button type=\"button\" title=\"导出 JSON\" aria-label=\"导出 JSON\" onClick={() => downloadText(\"director-composition.json\", JSON.stringify(state.composition, null, 2))}><Download size={16} /></button>\n          <button type=\"button\" title=\"截图\" aria-label=\"截图\" onClick={captureCanvas}><Camera size={16} /></button>\n          <span className=\"director-stage__app-dots\" aria-hidden=\"true\">⋮⋮⋮</span>\n        </div>\n      </header>\n\n      <div className=\"director-stage__body\">\n        <aside className=\"director-stage__rail\" aria-label=\"素材和层级\">\n          <section>\n            <div className=\"director-stage__panel-title\">场景</div>\n            <label className=\"director-stage__search\">\n              <Search size={16} />\n              <input placeholder=\"请输入搜索内容\" />\n            </label>\n            <div className=\"director-stage__asset-grid\">\n              <button type=\"button\" onClick={() => dispatch({ type: \"addCharacter\" })}>\n                <UserPlus size={18} />\n                <span>角色</span>\n              </button>\n              <button type=\"button\" onClick={() => fileInputRef.current?.click()}>\n                <Upload size={18} />\n                <span>GLB</span>\n              </button>\n              <button type=\"button\" onClick={() => dispatch({ type: \"addCamera\" })}>\n                <Camera size={18} />\n                <span>机位</span>\n              </button>\n            </div>\n            <input\n              ref={fileInputRef}\n              type=\"file\"\n              accept=\".glb,.gltf,model/gltf-binary,model/gltf+json\"\n              hidden\n              onChange={(event) => addUploadedModel(event.target.files?.[0])}\n            />\n            <div className=\"director-stage__prop-add\">\n              <select value={propType} onChange={(event) => setPropType(event.target.value as DirectorPropType)}>\n                {PROP_OPTIONS.map((option) => (\n                  <option key={option.type} value={option.type}>{option.label}</option>\n                ))}\n              </select>\n              <button type=\"button\" onClick={() => dispatch({ type: \"addProp\", propType })}>\n                <Box size={16} />加入\n              </button>\n            </div>\n          </section>\n\n          <section>\n            <div className=\"director-stage__panel-title\">层级</div>\n            <SceneTree\n              composition={state.composition}\n              selection={state.selection}\n              onSelect={(selection) => dispatch({ type: \"select\", selection })}\n              onDuplicate={(selection) => dispatch({ type: \"duplicateItem\", selection })}\n              onRemove={(selection) => dispatch({ type: \"removeItem\", selection })}\n              onToggleLocked={(selection, locked) => dispatch({ type: \"setItemLocked\", selection, locked })}\n              onToggleVisible={(selection, visible) => dispatch({ type: \"setItemVisible\", selection, visible })}\n            />\n          </section>\n        </aside>\n\n        <main className=\"director-stage__viewport\">\n          <ViewportToolbar\n            transformMode={state.transformMode}\n            viewMode={state.viewMode}\n            onRemoveSelected={() => dispatch({ type: \"removeSelected\" })}\n            onSetTransformMode={(mode) => dispatch({ type: \"setTransformMode\", mode })}\n            onSetViewMode={(mode) => dispatch({ type: \"setViewMode\", mode })}\n          />\n\n          <DirectorStageCanvas\n            composition={state.composition}\n            selection={state.selection}\n            transformMode={state.transformMode}\n            viewMode={state.viewMode}\n            activeCameraId={state.activeCameraId}\n            onSelect={(selection) => dispatch({ type: \"select\", selection })}\n            onTransform={(transform) => dispatch({ type: \"transformSelected\", transform })}\n          />\n\n          {aspectNumber ? (\n            <div className=\"director-stage__aspect-frame\" style={{ aspectRatio: aspectNumber }} aria-hidden=\"true\" />\n          ) : null}\n\n          <BottomTools\n            aspectRatio={aspectRatio}\n            isFullscreen={isFullscreen}\n            openMenu={openMenu}\n            transformMode={state.transformMode}\n            onAddCamera={addCamera}\n            onAddCharacter={addCharacter}\n            onAddCrowd={addCrowd}\n            onAddProp={addProp}\n            onApplyCurrentViewCamera={applyCurrentViewCamera}\n            onClickUpload={() => fileInputRef.current?.click()}\n            onSetAspectRatio={setAspectRatio}\n            onSetMode={setMode}\n            onSetOpenMenu={setOpenMenu}\n            onToggleFullscreen={toggleFullscreen}\n          />\n        </main>\n\n        <aside className=\"director-stage__inspector\" aria-label=\"属性检查器\">\n          <SelectionInspector\n            composition={state.composition}\n            selectedItem={selectedItem}\n            onPatchCharacter={(id, patch) => dispatch({ type: \"updateCharacter\", id, patch })}\n            onPatchProp={(id, patch) => dispatch({ type: \"updateProp\", id, patch })}\n            onPatchCamera={(id, patch) => dispatch({ type: \"updateCamera\", id, patch })}\n          />\n          <EnvironmentInspector\n            environment={state.composition.environment}\n            onPatch={(patch) => dispatch({ type: \"updateEnvironment\", patch })}\n          />\n\n          <section>\n            <div className=\"director-stage__panel-title\">场景 Seed</div>\n            <textarea value={jsonDraft} spellCheck={false} onChange={(event) => setJsonDraft(event.target.value)} />\n            <div className=\"director-stage__json-actions\">\n              <button type=\"button\" onClick={importJson}>导入</button>\n              <button type=\"button\" onClick={() => setJsonDraft(JSON.stringify(DEFAULT_COMPOSITION, null, 2))}>当前</button>\n            </div>\n            <p className=\"director-stage__hint\">{jsonMessage}</p>\n          </section>\n        </aside>\n      </div>\n    </div>\n  );\n}\n",
      "type": "registry:component",
      "target": "components/director-stage/DirectorStage.tsx"
    },
    {
      "path": "src/components/director-stage/DirectorStage.css",
      "content": ".director-stage {\n  --stage-bg: #fbfbfa;\n  --stage-panel: #ffffff;\n  --stage-panel-2: #f7f7f6;\n  --stage-line: #e8e8e6;\n  --stage-line-strong: #dededb;\n  --stage-text: #1f2328;\n  --stage-muted: #8c8f94;\n  --stage-dim: #b1b4b8;\n  --stage-gold: #f6c400;\n  --stage-cyan: #4a7cff;\n  --stage-green: #77c78c;\n  display: grid;\n  grid-template-rows: 54px minmax(0, 1fr);\n  width: 100%;\n  height: 100vh;\n  min-height: 620px;\n  overflow: hidden;\n  background: var(--stage-bg);\n  color: var(--stage-text);\n  font-family:\n    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\",\n    sans-serif;\n}\n\n.director-stage *,\n.director-stage *::before,\n.director-stage *::after {\n  box-sizing: border-box;\n}\n\n.director-stage button,\n.director-stage input,\n.director-stage select,\n.director-stage textarea {\n  font: inherit;\n  letter-spacing: 0;\n}\n\n.director-stage button {\n  cursor: pointer;\n}\n\n.director-stage__topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  border-bottom: 1px solid var(--stage-line);\n  background: #ffffff;\n  padding: 0 18px;\n}\n\n.director-stage__brand {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.director-stage__brand-mark {\n  display: grid;\n  width: 26px;\n  height: 26px;\n  place-items: center;\n  border-radius: 2px;\n  background: var(--stage-gold);\n  color: #6e5b00;\n  font-size: 14px;\n  line-height: 1;\n}\n\n.director-stage h1 {\n  margin: 0;\n  font-size: 15px;\n  font-weight: 760;\n  line-height: 1.15;\n}\n\n.director-stage__top-actions,\n.director-stage__json-actions,\n.director-stage__prop-add {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.director-stage__top-actions button,\n.director-stage__prop-add button,\n.director-stage__json-actions button,\n.director-stage__pose-grid button,\n.director-stage__asset-grid button {\n  display: inline-flex;\n  min-height: 34px;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  border: 1px solid var(--stage-line);\n  border-radius: 8px;\n  background: var(--stage-panel-2);\n  color: var(--stage-text);\n  font-size: 13px;\n  font-weight: 690;\n  line-height: 1;\n  padding: 0 11px;\n}\n\n.director-stage__top-actions button:hover,\n.director-stage__prop-add button:hover,\n.director-stage__json-actions button:hover,\n.director-stage__pose-grid button:hover,\n.director-stage__asset-grid button:hover,\n.director-stage__tree-item:hover,\n.director-stage__segmented button:hover,\n.director-stage__icon-button:hover {\n  border-color: rgba(217, 182, 92, 0.55);\n  color: #111111;\n}\n\n.director-stage__body {\n  display: grid;\n  min-height: 0;\n  grid-template-columns: 280px minmax(520px, 1fr) 340px;\n}\n\n.director-stage.is-fullscreen .director-stage__body {\n  grid-template-columns: minmax(0, 1fr);\n}\n\n.director-stage.is-fullscreen .director-stage__rail,\n.director-stage.is-fullscreen .director-stage__inspector {\n  display: none;\n}\n\n.director-stage__rail,\n.director-stage__inspector {\n  min-height: 0;\n  overflow-y: auto;\n  background: var(--stage-panel);\n  padding: 16px;\n}\n\n.director-stage__rail {\n  border-right: 1px solid var(--stage-line);\n}\n\n.director-stage__inspector {\n  border-left: 1px solid var(--stage-line);\n}\n\n.director-stage__rail section + section,\n.director-stage__inspector section + section {\n  border-top: 1px solid var(--stage-line);\n  margin-top: 16px;\n  padding-top: 16px;\n}\n\n.director-stage__panel-title,\n.director-stage__section-title,\n.director-stage__tree-title {\n  color: var(--stage-text);\n  font-size: 14px;\n  font-weight: 780;\n  line-height: 1.2;\n  margin-bottom: 10px;\n}\n\n.director-stage__tree-title {\n  display: flex;\n  justify-content: space-between;\n  color: var(--stage-muted);\n  font-size: 13px;\n  font-weight: 620;\n  margin: 18px 4px 8px;\n}\n\n.director-stage__search {\n  display: grid;\n  grid-template-columns: 18px minmax(0, 1fr);\n  align-items: center;\n  gap: 8px;\n  height: 42px;\n  border: 1px solid var(--stage-line);\n  border-radius: 8px;\n  color: #a1a5aa;\n  padding: 0 12px;\n  margin: 14px 0 16px;\n}\n\n.director-stage__search input {\n  border: 0 !important;\n  box-shadow: none !important;\n  height: 38px !important;\n  padding: 0 !important;\n  background: transparent !important;\n}\n\n.director-stage__asset-grid {\n  display: none;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 8px;\n}\n\n.director-stage__asset-grid button {\n  min-width: 0;\n  flex-direction: column;\n  height: 62px;\n  padding: 8px;\n}\n\n.director-stage__asset-grid span {\n  overflow: hidden;\n  max-width: 100%;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.director-stage__prop-add {\n  display: none;\n  margin-top: 10px;\n}\n\n.director-stage select,\n.director-stage input:not([type=\"range\"]):not([type=\"checkbox\"]),\n.director-stage textarea {\n  width: 100%;\n  min-width: 0;\n  border: 1px solid var(--stage-line);\n  border-radius: 8px;\n  background: #ffffff;\n  color: var(--stage-text);\n  outline: none;\n}\n\n.director-stage select,\n.director-stage input:not([type=\"range\"]):not([type=\"checkbox\"]) {\n  height: 34px;\n  padding: 0 10px;\n}\n\n.director-stage input[type=\"checkbox\"] {\n  width: 18px;\n  height: 18px;\n  accent-color: var(--stage-gold);\n}\n\n.director-stage input[type=\"color\"] {\n  min-width: 52px;\n  padding: 4px;\n}\n\n.director-stage select:focus,\n.director-stage input:focus,\n.director-stage textarea:focus {\n  border-color: var(--stage-gold);\n  box-shadow: 0 0 0 2px rgba(217, 182, 92, 0.16);\n}\n\n.director-stage__tree {\n  display: block;\n}\n\n.director-stage__tree-item {\n  display: grid;\n  width: 100%;\n  grid-template-columns: 22px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 10px;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  background: transparent;\n  color: #73777c;\n  min-height: 35px;\n  padding: 0 7px 0 10px;\n  text-align: left;\n}\n\n.director-stage__tree-item span:nth-child(2) {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.director-stage__tree-item.is-active {\n  border-color: transparent;\n  background: transparent;\n  color: #1d1f23;\n  font-weight: 760;\n}\n\n.director-stage__tree-actions {\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n  justify-self: end;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 120ms ease;\n}\n\n.director-stage__tree-item:hover .director-stage__tree-actions,\n.director-stage__tree-item.is-active .director-stage__tree-actions,\n.director-stage__tree-actions:focus-within {\n  opacity: 1;\n  pointer-events: auto;\n}\n\n.director-stage__tree-actions button {\n  display: grid;\n  width: 25px;\n  height: 25px;\n  place-items: center;\n  border: 0;\n  border-radius: 5px;\n  background: transparent;\n  color: #8d9196;\n  padding: 0;\n}\n\n.director-stage__tree-actions button:hover {\n  background: #f2f2f1;\n  color: #202327;\n}\n\n.director-stage__tree-icon {\n  display: grid;\n  place-items: center;\n  color: #999da2;\n  font-size: 16px;\n}\n\n.director-stage__tree-icon.is-character {\n  color: #4a7cff;\n}\n\n.director-stage__viewport {\n  position: relative;\n  min-width: 0;\n  min-height: 0;\n  background: #f8f8f7;\n}\n\n.director-stage__viewport canvas {\n  display: block;\n}\n\n.director-stage__camera-monitor {\n  overflow: hidden;\n  border: 1px solid var(--stage-line-strong);\n  border-radius: 8px;\n  background: #f5f5f4;\n  box-shadow: none;\n  margin-bottom: 16px;\n}\n\n.director-stage__camera-monitor-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  height: 30px;\n  border-bottom: 1px solid rgba(0, 0, 0, 0.08);\n  color: #55585d;\n  font-size: 12px;\n  font-weight: 720;\n  line-height: 1;\n  padding: 0 10px;\n}\n\n.director-stage__camera-monitor-head span {\n  overflow: hidden;\n  min-width: 0;\n  text-overflow: ellipsi